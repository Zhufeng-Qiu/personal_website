<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0f1012">
    <title>
      {% if page.home %}Zhufeng (Zephyr) Qiu{% else %}{{ page.title }} · Zephyr{% endif %}
    </title>
    <meta name="description" content="{{ page.description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/favicon.png' | relative_url }}">
    <script>
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="{{ '/assets/portfolio/portfolio.css' | relative_url }}">
    {% if page.lab %}<link rel="stylesheet" href="{{ '/assets/portfolio/labs.css' | relative_url }}">{% endif %}
    <script src="{{ '/assets/portfolio/lab-models.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/portfolio/motion.js' | relative_url }}" defer></script>
    {% for script in page.scripts %}
      <script src="{{ '/assets/portfolio/' | append: script | append: '.js' | relative_url }}" defer></script>
    {% endfor %}
  </head>
  <body class="{% if page.home %}portfolio-home{% else %}lab-page{% endif %}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="header-inner">
        <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="Zephyr, interactive home">ZQ <span>/</span> ZEPHYR</a>
        {% if page.home %}
          <nav class="section-nav" aria-label="Sections">
            <a href="#work">Work</a><a href="#lab">Lab</a><a href="#experience">Experience</a><a href="#education">Education</a
            ><a href="#contact">Contact</a><a href="#life">Life</a>
            <span class="nav-indicator" aria-hidden="true"></span>
          </nav>
        {% else %}
          <nav class="section-nav lab-nav" aria-label="Lab navigation"><a href="{{ '/' | relative_url }}#lab">← All labs</a></nav>
        {% endif %}
        <a class="button button-small academic-link" href="{{ '/academic/' | relative_url }}">Academic <span aria-hidden="true">↗</span></a>
      </div>
      <span class="scroll-progress" aria-hidden="true"></span>
    </header>
    <main id="main" class="site-main">{{ content }}</main>
    <footer class="site-footer">
      <span>Zhufeng (Zephyr) Qiu <span aria-hidden="true">·</span> Seattle</span>
      <span class="footer-note">Curious for life. Measured in method. Resilient in practice.</span>
      <a href="#top" data-to-top>Back to top ↑</a>
    </footer>
  </body>
</html>
